FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    ffmpeg \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY agents_runtime/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY agents_runtime/ /app/
COPY GoldenSet/ /app/GoldenSet/

ENV PYTHONUNBUFFERED=1 \
    LOG_LEVEL=INFO \
    ENVIRONMENT=test \
    PORT=8080 \
    PYTHONPATH=/app \
    GCP_PROJECT=coherence-ominichannel-fs

CMD ["python", "-m", "scripts.reindex_golden_set"]
